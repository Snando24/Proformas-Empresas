# ============================================================
# EJEMPLO DE ARCHIVO .env
# ============================================================
# Copia este archivo a .env y reemplaza los valores con
# tus configuraciones locales. Nunca subas .env al repo.
# ============================================================

# ============================================================
# SERVIDOR
# ============================================================
# Puerto en el que corre el servidor HTTP
PORT=3000

# Host del servidor
HOST=localhost

# ============================================================
# CONFIGURACIÓN DE EMPRESA
# ============================================================
# Empresa por defecto (debe existir en configs/companies/)
DEFAULT_COMPANY=jc-services

# ============================================================
# RUTAS DE DIRECTORIOS
# ============================================================
# Directorio de configuraciones de empresas
COMPANIES_CONFIG_DIR=configs/companies

# Directorio de assets (imágenes)
ASSETS_DIR=static/assets

# Directorio de salida para PDFs
OUTPUT_PDF_DIR=output/pdf

# Directorio de salida para DOCXs
OUTPUT_DOCX_DIR=output/docx

# Directorio temporal
TMP_DIR=tmp

# ============================================================
# LOGGING
# ============================================================
# Nivel de logging (debug, info, warn, error)
LOG_LEVEL=info

# ============================================================
# DESARROLLO
# ============================================================
# Modo desarrollo (true/false)
DEBUG=false

# Recargar servidor en cambios de archivos (development)
WATCH_MODE=true
